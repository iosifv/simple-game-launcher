<Window x:Class="GameLauncher.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:sys="clr-namespace:System;assembly=System.Runtime"
        Title="Simple Game Launcher" Width="1180" Height="760" MinWidth="640" MinHeight="420"
        WindowStartupLocation="CenterScreen" Background="Transparent"
        Foreground="{StaticResource TextBrush}" Icon="app.ico" UseLayoutRounding="True"
        PreviewKeyDown="OnPreviewKeyDown" PreviewTextInput="OnPreviewTextInput">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="52" ResizeBorderThickness="6" GlassFrameThickness="-1"
                      CornerRadius="0" UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolVis" />
        <sys:Double x:Key="TileWidth">230</sys:Double>
        <sys:Double x:Key="ArtHeight">107</sys:Double>
        <!-- Swapped from code by ApplyCardLook() -->
        <Visibility x:Key="CardTextVis">Visible</Visibility>
        <Visibility x:Key="NameOverlayVis">Collapsed</Visibility>
        <Visibility x:Key="TabGripVis">Collapsed</Visibility>
        <!-- Settings.TrainersEnabled (ApplyTrainerUi): trainer menu items and settings -->
        <Visibility x:Key="TrainerVis">Visible</Visibility>
        <!-- Half of Settings.CardSpacing on each side of a card (ApplyTileSize) -->
        <Thickness x:Key="TileMargin">6</Thickness>
        <!-- Settings.DiceColor (ApplyDiceColor) -->
        <SolidColorBrush x:Key="DiceBrush" Color="#60CDFF" />
        <sys:Boolean x:Key="CardTipOn">False</sys:Boolean>
        <CornerRadius x:Key="ArtCorner">6,6,0,0</CornerRadius>
        <Thickness x:Key="IconMargin">0</Thickness>

        <Style x:Key="CaptionBtn" TargetType="Button">
            <Setter Property="Width" Value="46" />
            <Setter Property="Height" Value="52" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="FontFamily" Value="Segoe Fluent Icons, Segoe MDL2 Assets" />
            <Setter Property="FontSize" Value="10" />
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="WindowChrome.IsHitTestVisibleInChrome" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="B" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="B" Property="Background" Value="#1AFFFFFF" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="B" Property="Background" Value="#0FFFFFFF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CloseBtn" TargetType="Button" BasedOn="{StaticResource CaptionBtn}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="B" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="B" Property="Background" Value="#C42B1C" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Round icon button used in the header -->
        <Style x:Key="HeaderBtn" TargetType="Button">
            <Setter Property="Width" Value="38" />
            <Setter Property="Height" Value="38" />
            <Setter Property="Margin" Value="2,0" />
            <Setter Property="FontFamily" Value="Segoe Fluent Icons, Segoe MDL2 Assets" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Foreground" Value="{StaticResource SecondaryBrush}" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="WindowChrome.IsHitTestVisibleInChrome" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="B" Background="Transparent" CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="B" Property="Background" Value="#1AFFFFFF" />
                                <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="B" Property="Background" Value="#0FFFFFFF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Tab-shaped button (Arrange, beside the filter tabs) -->
        <Style x:Key="ChipBtn" TargetType="Button">
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Foreground" Value="{StaticResource SecondaryBrush}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="B" CornerRadius="14" Padding="12,5,13,5" Background="Transparent"
                                BorderBrush="#1FFFFFFF" BorderThickness="1">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="B" Property="Background" Value="#1AFFFFFF" />
                                <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="B" Property="Background" Value="#0FFFFFFF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PillBtn" TargetType="Button">
            <Setter Property="Margin" Value="0,0,6,6" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="B" Background="#24000000" BorderBrush="#1AFFFFFF" BorderThickness="1"
                                CornerRadius="6" Padding="9,5">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="B" Property="Background" Value="#1FFFFFFF" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="B" Property="Background" Value="#0AFFFFFF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Round play button that fades in over a hovered tile (animated in "tile hover effect") -->
        <Style x:Key="PlayBtn" TargetType="Button">
            <Setter Property="Width" Value="58" />
            <Setter Property="Height" Value="58" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="B" CornerRadius="29" Background="#B3101014" BorderBrush="#66FFFFFF" BorderThickness="1.5">
                            <Border.Effect>
                                <DropShadowEffect ShadowDepth="2" BlurRadius="14" Opacity="0.5" Color="Black" />
                            </Border.Effect>
                            <TextBlock x:Name="G" Text="&#xF5B0;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="20"
                                       Foreground="{TemplateBinding Foreground}" HorizontalAlignment="Center"
                                       VerticalAlignment="Center" Margin="3,0,0,0" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="B" Property="Background" Value="{StaticResource AccentBrush}" />
                                <Setter TargetName="B" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                                <Setter TargetName="G" Property="Foreground" Value="#101014" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="B" Property="Opacity" Value="0.85" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="TrainerBadge" TargetType="Button">
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="B" Background="#E62E2650" BorderBrush="#66B4A0FF" BorderThickness="1"
                                CornerRadius="5" Padding="7,3">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE768;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="9"
                                           Foreground="#D9D0FF" VerticalAlignment="Center" Margin="0,0,5,0" />
                                <TextBlock Text="TRAINER" FontSize="10" FontWeight="SemiBold" Foreground="#D9D0FF" />
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="B" Property="Background" Value="#FF4A3D80" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <ContextMenu x:Key="TileMenu" x:Shared="False">
            <MenuItem Header="Play" InputGestureText="Enter" Tag="play" Click="Menu_Click" FontWeight="SemiBold" />
            <MenuItem Header="Play with trainer" InputGestureText="Ctrl+Enter" Tag="playtrainer" Click="Menu_Click"
                      IsEnabled="{Binding HasTrainer}" />
            <Separator />
            <!-- Both trainer items are hidden in Tile_ContextMenuOpening when trainers are off -->
            <MenuItem Header="Trainer" Tag="trainermenu">
                <MenuItem Header="Choose trainer…" Tag="settrainer" Click="Menu_Click" />
                <MenuItem Header="Auto-detect from z folder" Tag="autotrainer" Click="Menu_Click" />
                <MenuItem Header="No trainer" Tag="notrainer" Click="Menu_Click" />
            </MenuItem>
            <MenuItem Header="Cover">
                <!-- Each shape has its own image. Enabled state / current-shape bold set in Tile_ContextMenuOpening -->
                <MenuItem Header="Find cover online…" Tag="findcover" Click="Menu_Click" />
                <Separator />
                <MenuItem Header="Choose landscape image…" Tag="setcover:landscape" Click="Menu_Click" />
                <MenuItem Header="Choose portrait image…" Tag="setcover:portrait" Click="Menu_Click" />
                <Separator />
                <MenuItem Header="Use automatic landscape cover" Tag="steamcover:landscape" Click="Menu_Click" />
                <MenuItem Header="Use automatic portrait cover" Tag="steamcover:portrait" Click="Menu_Click" />
                <Separator />
                <MenuItem Header="Icon only" Tag="nocover" Click="Menu_Click" />
            </MenuItem>
            <MenuItem Header="Edit tags…" Tag="tags" Click="Menu_Click" />
            <MenuItem Header="Arrange games…" Tag="arrange" Click="Menu_Click" />
            <Separator />
            <MenuItem Header="Show in File Explorer" Tag="reveal" Click="Menu_Click" />
            <Separator />
            <!-- "Hide" / "Show again" (set in Tile_ContextMenuOpening): only the Hidden filter lists hidden games -->
            <MenuItem Header="Hide" Tag="hide" Click="Menu_Click">
                <MenuItem.Icon>
                    <TextBlock Text="&#xED1A;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="14" />
                </MenuItem.Icon>
            </MenuItem>
            <!-- Moves the shortcut file to the Recycle Bin after a confirmation (DeleteShortcut) -->
            <MenuItem Header="Delete…" Tag="delete" Click="Menu_Click" Foreground="{StaticResource DangerBrush}">
                <MenuItem.Icon>
                    <TextBlock Text="&#xE74D;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="14"
                               Foreground="{StaticResource DangerBrush}" />
                </MenuItem.Icon>
            </MenuItem>
        </ContextMenu>

        <ContextMenu x:Key="TabMenu" x:Shared="False">
            <MenuItem Header="Set wallpaper for this filter…" Tag="set" Click="TabMenu_Click" />
            <MenuItem Header="Remove wallpaper" Tag="clear" Click="TabMenu_Click" />
            <Separator />
            <MenuItem Header="Settings…" InputGestureText="Ctrl+," Tag="settings" Click="TabMenu_Click" />
        </ContextMenu>

        <Style x:Key="TileStyle" TargetType="ListBoxItem">
            <Setter Property="Margin" Value="{DynamicResource TileMargin}" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="ContextMenu" Value="{StaticResource TileMenu}" />
            <EventSetter Event="MouseDoubleClick" Handler="Tile_DoubleClick" />
            <EventSetter Event="ContextMenuOpening" Handler="Tile_ContextMenuOpening" />
            <EventSetter Event="MouseEnter" Handler="Tile_MouseEnter" />
            <EventSetter Event="MouseLeave" Handler="Tile_MouseLeave" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Card" Width="{DynamicResource TileWidth}" CornerRadius="8" Background="#B31E1E24"
                                BorderBrush="#16FFFFFF" BorderThickness="2" SnapsToDevicePixels="True" Cursor="Hand"
                                ToolTip="{Binding Name}" ToolTipService.IsEnabled="{DynamicResource CardTipOn}">
                            <StackPanel>
                                <Grid Height="{DynamicResource ArtHeight}">
                                    <!-- Cards without a cover: radial glow in the icon's colour (IconBackdrop); hidden under covers -->
                                    <Border x:Name="ArtBg" CornerRadius="{DynamicResource ArtCorner}"
                                            Background="{Binding IconBackdrop, TargetNullValue=#0AFFFFFF}" />
                                    <Image x:Name="IconImg" Source="{Binding Icon}" Width="60" Height="60" Margin="{DynamicResource IconMargin}"
                                           RenderOptions.BitmapScalingMode="HighQuality">
                                        <Image.Effect>
                                            <DropShadowEffect ShadowDepth="3" BlurRadius="16" Opacity="0.5" Color="Black" />
                                        </Image.Effect>
                                    </Image>
                                    <!-- Cover of the other shape: soft blurred backdrop + the whole image letterboxed -->
                                    <Border x:Name="CoverBackdrop" CornerRadius="{DynamicResource ArtCorner}" Opacity="0.6" Visibility="Collapsed">
                                        <Border.Background>
                                            <ImageBrush ImageSource="{Binding CoverFill}" Stretch="UniformToFill" />
                                        </Border.Background>
                                    </Border>
                                    <Image x:Name="CoverFitted" Source="{Binding Cover}" Stretch="Uniform" Visibility="Collapsed"
                                           RenderOptions.BitmapScalingMode="HighQuality" />
                                    <Border x:Name="CoverFull" CornerRadius="{DynamicResource ArtCorner}">
                                        <Border.Background>
                                            <ImageBrush ImageSource="{Binding Cover}" Stretch="UniformToFill" />
                                        </Border.Background>
                                    </Border>
                                    <!-- Light sweep on hover; its brush is created and animated in code -->
                                    <Border x:Name="Shine" CornerRadius="{DynamicResource ArtCorner}" Opacity="0" IsHitTestVisible="False" />
                                    <!-- Play button: hidden until the tile is hovered (Tile_MouseEnter) -->
                                    <Button x:Name="PlayBtn" Style="{StaticResource PlayBtn}" Opacity="0" IsHitTestVisible="False"
                                            HorizontalAlignment="Center" VerticalAlignment="Center" RenderTransformOrigin="0.5,0.5"
                                            Click="PlayBtn_Click" ToolTip="{Binding PlayTip}">
                                        <Button.RenderTransform>
                                            <ScaleTransform ScaleX="0.75" ScaleY="0.75" />
                                        </Button.RenderTransform>
                                    </Button>
                                    <!-- Name over icon-only cards when names under cards are hidden -->
                                    <TextBlock x:Name="NameOverlay" Text="{Binding Name}" Visibility="{DynamicResource NameOverlayVis}"
                                               VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="10,0,10,9"
                                               FontSize="12.5" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                    <Button Style="{StaticResource TrainerBadge}" HorizontalAlignment="Right"
                                            VerticalAlignment="Top" Margin="6" Click="TrainerBadge_Click"
                                            ToolTip="{Binding TrainerTip}"
                                            Visibility="{Binding HasTrainer, Converter={StaticResource BoolVis}}" />
                                    <!-- Arrange-mode drag handle -->
                                    <Border Background="#D9101014" CornerRadius="5" Padding="6,4" Margin="6"
                                            HorizontalAlignment="Left" VerticalAlignment="Top"
                                            Visibility="{Binding Arranging, Converter={StaticResource BoolVis}}">
                                        <TextBlock Text="&#xE700;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="12"
                                                   Foreground="{StaticResource AccentBrush}" />
                                    </Border>
                                </Grid>
                                <StackPanel Margin="10,7,10,9" Visibility="{DynamicResource CardTextVis}">
                                    <TextBlock Text="{Binding Name}" FontSize="13" FontWeight="SemiBold"
                                               TextTrimming="CharacterEllipsis" ToolTip="{Binding Name}" />
                                    <TextBlock Text="{Binding SubText}" FontSize="11" Margin="0,2,0,0"
                                               Foreground="{StaticResource MutedBrush}" TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <DataTrigger Binding="{Binding CoverFits}" Value="False">
                                <Setter TargetName="CoverBackdrop" Property="Visibility" Value="Visible" />
                                <Setter TargetName="CoverFitted" Property="Visibility" Value="Visible" />
                                <Setter TargetName="CoverFull" Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding HasCover}" Value="True">
                                <Setter TargetName="NameOverlay" Property="Visibility" Value="Collapsed" />
                                <Setter TargetName="IconImg" Property="Visibility" Value="Collapsed" />
                                <Setter TargetName="ArtBg" Property="Background" Value="#0AFFFFFF" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Arranging}" Value="True">
                                <Setter TargetName="Card" Property="Cursor" Value="SizeAll" />
                                <Setter TargetName="Card" Property="BorderBrush" Value="#5560CDFF" />
                            </DataTrigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Card" Property="Background" Value="#CC2A2A32" />
                                <Setter TargetName="Card" Property="BorderBrush" Value="#30FFFFFF" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Card" Property="Background" Value="#CC2A2A32" />
                                <Setter TargetName="Card" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                            </Trigger>
                            <!-- The tile being dragged leaves a faint placeholder behind -->
                            <DataTrigger Binding="{Binding IsDragging}" Value="True">
                                <Setter TargetName="Card" Property="Opacity" Value="0.25" />
                                <Setter TargetName="Card" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                            </DataTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="TabStyle" TargetType="ListBoxItem">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Margin" Value="0,0,4,0" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="ContextMenu" Value="{StaticResource TabMenu}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="B" CornerRadius="14" Padding="13,5" Background="Transparent"
                                BorderThickness="1" BorderBrush="Transparent">
                            <StackPanel Orientation="Horizontal">
                                <!-- Arrange-mode grip -->
                                <TextBlock Text="&#xE700;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="10"
                                           Foreground="{StaticResource AccentBrush}" VerticalAlignment="Center" Margin="0,1,7,0"
                                           Visibility="{DynamicResource TabGripVis}" />
                                <!-- Tag filters: tag icon instead of "#" -->
                                <TextBlock x:Name="TagIcon" Text="&#xE8EC;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="12"
                                           Foreground="{Binding Foreground, ElementName=T}" VerticalAlignment="Center" Margin="0,1,6,0"
                                           Visibility="{Binding IsTag, Converter={StaticResource BoolVis}}" />
                                <TextBlock Text="&#xED1A;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="12"
                                           Foreground="{Binding Foreground, ElementName=T}" VerticalAlignment="Center" Margin="0,1,6,0"
                                           Visibility="{Binding IsHidden, Converter={StaticResource BoolVis}}" />
                                <TextBlock x:Name="T" Text="{Binding Label}" FontSize="12.5"
                                           Foreground="{StaticResource SecondaryBrush}" />
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="B" Property="Background" Value="#1AFFFFFF" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="B" Property="Background" Value="#3360CDFF" />
                                <Setter TargetName="T" Property="Foreground" Value="{StaticResource AccentBrush}" />
                                <Setter TargetName="T" Property="FontWeight" Value="SemiBold" />
                            </Trigger>
                            <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource AncestorType=ListBox}}" Value="arranging">
                                <Setter Property="Cursor" Value="SizeAll" />
                                <Setter TargetName="B" Property="BorderBrush" Value="#3360CDFF" />
                            </DataTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SectionCard" TargetType="Border">
            <Setter Property="Background" Value="#10FFFFFF" />
            <Setter Property="BorderBrush" Value="#14FFFFFF" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="16,14" />
            <Setter Property="Margin" Value="0,0,0,14" />
        </Style>
        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,0,0,4" />
        </Style>
        <Style x:Key="Hint" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style x:Key="SmallBtn" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Padding" Value="10,3" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="MinHeight" Value="0" />
        </Style>
        <Style x:Key="AccentSmallBtn" TargetType="Button">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="B" Background="{StaticResource AccentBrush}" CornerRadius="5" Padding="16,5">
                            <ContentPresenter HorizontalAlignment="Center" TextElement.Foreground="#0B1A24"
                                              TextElement.FontWeight="SemiBold" TextElement.FontSize="12" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="B" Property="Background" Value="#86DBFF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border x:Name="RootBorder">
        <Grid ClipToBounds="True">
            <Grid.RowDefinitions>
                <RowDefinition Height="52" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="30" />
            </Grid.RowDefinitions>

            <!-- Wallpaper layer (per filter) -->
            <Image x:Name="WallpaperImage" Grid.RowSpan="5" Stretch="UniformToFill" Opacity="0"
                   RenderOptions.BitmapScalingMode="HighQuality" IsHitTestVisible="False" />
            <Rectangle x:Name="WallpaperShade" Grid.RowSpan="5" Fill="#0E0E12" Opacity="0" IsHitTestVisible="False" />

            <!-- Header: icon + search + actions, all in the title bar -->
            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Image Source="app.ico" Width="20" Height="20" Margin="18,0,10,0" VerticalAlignment="Center" />
                <!-- App name; part of the draggable title bar. Hidden when the window is narrow (OnSizeChanged). -->
                <TextBlock x:Name="AppTitle" Grid.Column="1" Text="Simple Game Launcher" FontSize="13" FontWeight="SemiBold"
                           Foreground="{StaticResource SecondaryBrush}" VerticalAlignment="Center" Margin="0,0,18,1" />
                <Grid Grid.Column="2" VerticalAlignment="Center" Margin="0,0,10,0" MaxWidth="900"
                      HorizontalAlignment="Stretch">
                    <TextBox x:Name="SearchBox" FontSize="14" Padding="36,6,12,6" VerticalContentAlignment="Center"
                             TextChanged="SearchBox_TextChanged" WindowChrome.IsHitTestVisibleInChrome="True" />
                    <TextBlock Text="&#xE721;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="14"
                               Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" Margin="13,0,0,0"
                               IsHitTestVisible="False" />
                    <TextBlock x:Name="Placeholder" Text="Search games — just start typing" FontSize="14"
                               Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" Margin="38,0,0,0"
                               IsHitTestVisible="False" />
                    <TextBlock x:Name="SearchHint" Text="Enter play   ·   Ctrl+Enter with trainer" FontSize="11.5"
                               Foreground="{StaticResource MutedBrush}" HorizontalAlignment="Right"
                               VerticalAlignment="Center" Margin="0,0,14,0" IsHitTestVisible="False" />
                </Grid>
                <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- Random game: a die drawn in DiceBrush; it spins while rolling (RollDice) -->
                    <Button x:Name="DiceBtn" Style="{StaticResource HeaderBtn}" ToolTip="Random game" Click="Dice_Click">
                        <Viewbox x:Name="DiceIcon" Width="19" Height="19" RenderTransformOrigin="0.5,0.5">
                            <Viewbox.RenderTransform>
                                <RotateTransform />
                            </Viewbox.RenderTransform>
                            <Grid Width="24" Height="24">
                                <Border CornerRadius="5" BorderThickness="2" BorderBrush="{DynamicResource DiceBrush}" Margin="1" />
                                <Ellipse Width="3.6" Height="3.6" Fill="{DynamicResource DiceBrush}" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="6,6,0,0" />
                                <Ellipse Width="3.6" Height="3.6" Fill="{DynamicResource DiceBrush}" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,6,6,0" />
                                <Ellipse Width="3.6" Height="3.6" Fill="{DynamicResource DiceBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                <Ellipse Width="3.6" Height="3.6" Fill="{DynamicResource DiceBrush}" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="6,0,0,6" />
                                <Ellipse Width="3.6" Height="3.6" Fill="{DynamicResource DiceBrush}" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,6,6" />
                            </Grid>
                        </Viewbox>
                    </Button>
                    <Button Style="{StaticResource HeaderBtn}" Content="&#xE72C;" ToolTip="Rescan folder (F5)" Click="Refresh_Click" />
                    <Button Style="{StaticResource HeaderBtn}" Content="&#xE838;" ToolTip="Open shortcuts folder" Click="OpenFolder_Click" />
                    <Button x:Name="SettingsBtn" Style="{StaticResource HeaderBtn}" Content="&#xE713;" ToolTip="Settings (Ctrl+,)" Click="Settings_Click" />
                    <Border Width="1" Height="18" Background="#22FFFFFF" Margin="8,0,4,0" />
                </StackPanel>
                <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Top">
                    <!-- Own caption buttons (drawn above wallpapers). Max button reports HTMAXBUTTON so Snap Layouts still work. -->
                    <StackPanel x:Name="CustomCaption" Orientation="Horizontal">
                        <Button Style="{StaticResource CaptionBtn}" Content="&#xE921;" Click="Min_Click" ToolTip="Minimize" />
                        <Button x:Name="MaxBtn" Style="{StaticResource CaptionBtn}" Content="&#xE922;" Click="Max_Click" />
                        <Button Style="{StaticResource CloseBtn}" Content="&#xE8BB;" Click="Close_Click" ToolTip="Hide to tray" />
                    </StackPanel>
                </StackPanel>
            </Grid>

            <!-- Launchers -->
            <!-- Drag to reorder in arrange mode (LaunchersBar_* handlers) -->
            <ItemsControl x:Name="LaunchersBar" Grid.Row="1" Margin="20,8,20,0"
                          PreviewMouseLeftButtonDown="LaunchersBar_PreviewMouseLeftButtonDown"
                          PreviewMouseMove="LaunchersBar_PreviewMouseMove"
                          PreviewMouseLeftButtonUp="LaunchersBar_PreviewMouseLeftButtonUp"
                          LostMouseCapture="LaunchersBar_LostMouseCapture">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Button Style="{StaticResource PillBtn}" Click="Launcher_Click" ToolTip="{Binding FilePath}">
                            <Button.ContextMenu>
                                <ContextMenu>
                                    <MenuItem Header="Show in File Explorer" Click="LauncherReveal_Click" />
                                    <Separator />
                                    <MenuItem Header="Delete…" Click="LauncherDelete_Click" Foreground="{StaticResource DangerBrush}">
                                        <MenuItem.Icon>
                                            <TextBlock Text="&#xE74D;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="14"
                                                       Foreground="{StaticResource DangerBrush}" />
                                        </MenuItem.Icon>
                                    </MenuItem>
                                </ContextMenu>
                            </Button.ContextMenu>
                            <StackPanel Orientation="Horizontal">
                                <!-- Arrange-mode grip, like the filter tabs -->
                                <TextBlock Text="&#xE700;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="10"
                                           Foreground="{StaticResource AccentBrush}" VerticalAlignment="Center" Margin="0,1,7,0"
                                           Visibility="{DynamicResource TabGripVis}" />
                                <Image Source="{Binding Icon}" Width="18" Height="18"
                                       RenderOptions.BitmapScalingMode="HighQuality" />
                                <TextBlock Text="{Binding Name}" FontSize="12" Margin="7,0,0,0" VerticalAlignment="Center"
                                           Foreground="{StaticResource SecondaryBrush}" />
                            </StackPanel>
                        </Button>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- Filter tabs -->
            <Grid Grid.Row="2" Margin="16,4,22,4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <ListBox x:Name="TabsList" ItemContainerStyle="{StaticResource TabStyle}" Background="Transparent"
                         BorderThickness="0" Padding="0" SelectionChanged="Tabs_SelectionChanged"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled" VerticalAlignment="Center"
                         PreviewMouseLeftButtonDown="TabsList_PreviewMouseLeftButtonDown"
                         PreviewMouseMove="TabsList_PreviewMouseMove"
                         PreviewMouseLeftButtonUp="TabsList_PreviewMouseLeftButtonUp"
                         LostMouseCapture="TabsList_LostMouseCapture">
                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel />
                        </ItemsPanelTemplate>
                    </ListBox.ItemsPanel>
                </ListBox>
                <StackPanel x:Name="TabsRight" Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0">
                    <TextBlock x:Name="CountText" VerticalAlignment="Center" FontSize="12" Margin="0,0,10,0"
                               Foreground="{StaticResource MutedBrush}" />
                    <Button x:Name="ShapeBtn" Style="{StaticResource ChipBtn}" Click="ShapeBtn_Click" Margin="0,0,4,0">
                        <StackPanel Orientation="Horizontal">
                            <Grid Width="14" Height="13" VerticalAlignment="Center" Margin="0,0,7,0">
                                <Border x:Name="ShapeGlyph" Width="14" Height="9" BorderThickness="1.4" CornerRadius="2"
                                        HorizontalAlignment="Center" VerticalAlignment="Center"
                                        BorderBrush="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                            </Grid>
                            <TextBlock x:Name="ShapeText" Text="Landscape" FontSize="12.5" />
                        </StackPanel>
                    </Button>
                    <Button x:Name="ArrangeBtn" Style="{StaticResource ChipBtn}" Click="ArrangeBtn_Click"
                            ToolTip="Arrange games and filters (custom order)">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE8CB;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="12"
                                       VerticalAlignment="Center" Margin="0,1,7,0" />
                            <TextBlock Text="Arrange" FontSize="12.5" />
                        </StackPanel>
                    </Button>
                </StackPanel>
                <Border x:Name="ArrangeBar" Grid.Column="1" Margin="12,0,0,0" HorizontalAlignment="Right" VerticalAlignment="Center" Visibility="Collapsed"
                        Background="#E6141A20" BorderBrush="#6660CDFF" BorderThickness="1" CornerRadius="8" Padding="12,5,6,5">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE8CB;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="13"
                                   Foreground="{StaticResource AccentBrush}" VerticalAlignment="Center" Margin="0,0,8,0" />
                        <TextBlock VerticalAlignment="Center" FontSize="12" Foreground="{StaticResource SecondaryBrush}"
                                   Text="Drag tiles, filters or launchers  ·  Alt+arrows nudge" Margin="0,0,14,0" />
                        <Button Style="{StaticResource SmallBtn}" Content="Reset to A–Z" Click="ArrangeReset_Click" Focusable="False" />
                        <Button Style="{StaticResource SmallBtn}" Content="Cancel" Margin="6,0,0,0" Click="ArrangeCancel_Click" Focusable="False" />
                        <Button Style="{StaticResource AccentSmallBtn}" Content="Done" Margin="6,0,0,0" Click="ArrangeDone_Click" />
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Games -->
            <ListBox x:Name="GamesList" Grid.Row="3" Margin="2,0,6,0" Padding="0" Background="Transparent"
                     BorderThickness="0" ItemContainerStyle="{StaticResource TileStyle}"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled" SelectionMode="Single"
                     KeyboardNavigation.DirectionalNavigation="None" SizeChanged="GamesList_SizeChanged"
                     PreviewMouseWheel="GamesList_PreviewMouseWheel"
                     PreviewMouseLeftButtonDown="GamesList_PreviewMouseLeftButtonDown"
                     PreviewMouseMove="GamesList_PreviewMouseMove"
                     PreviewMouseLeftButtonUp="GamesList_PreviewMouseLeftButtonUp"
                     LostMouseCapture="GamesList_LostMouseCapture">
                <ListBox.ItemsPanel>
                    <ItemsPanelTemplate>
                        <!-- Room inside the scroll area so a hovered card (scaled, lifted, glowing) isn't clipped
                             at the edges. Keep in sync with PanelPadX in ApplyTileSize. -->
                        <WrapPanel Margin="12,12,10,16" />
                    </ItemsPanelTemplate>
                </ListBox.ItemsPanel>
            </ListBox>
            <TextBlock x:Name="EmptyText" Grid.Row="3" HorizontalAlignment="Center" VerticalAlignment="Center"
                       FontSize="15" Foreground="{StaticResource MutedBrush}" Visibility="Collapsed" />

            <!-- Status bar -->
            <Border Grid.Row="4" BorderBrush="#14FFFFFF" BorderThickness="0,1,0,0" Background="#33000000">
                <Grid Margin="20,0">
                    <TextBlock x:Name="StatusText" VerticalAlignment="Center" FontSize="11.5"
                               Foreground="{StaticResource MutedBrush}" TextTrimming="CharacterEllipsis" Margin="0,0,260,0" />
                    <TextBlock x:Name="HotkeyText" HorizontalAlignment="Right" VerticalAlignment="Center" FontSize="11.5"
                               Foreground="{StaticResource MutedBrush}" />
                </Grid>
            </Border>

            <!-- Floating copy of the tile being dragged -->
            <Canvas x:Name="DragCanvas" Grid.RowSpan="5" IsHitTestVisible="False" ClipToBounds="True" />

            <!-- Settings drawer -->
            <Border x:Name="SettingsPanel" Grid.Row="1" Grid.RowSpan="4" Width="420" HorizontalAlignment="Right"
                    Visibility="Collapsed" Background="#F21A1A20" BorderBrush="#26FFFFFF" BorderThickness="1,1,0,0"
                    CornerRadius="10,0,0,0">
                <Border.RenderTransform>
                    <TranslateTransform x:Name="SettingsSlide" />
                </Border.RenderTransform>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid Margin="20,16,12,10">
                        <TextBlock Text="Settings" FontSize="20" FontWeight="SemiBold" VerticalAlignment="Center" />
                        <Button Style="{StaticResource HeaderBtn}" Content="&#xE8BB;" FontSize="11" HorizontalAlignment="Right"
                                ToolTip="Close (Esc)" Click="Settings_Click" />
                    </Grid>
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="20,0,20,16">
                        <StackPanel>

                            <!-- Card size -->
                            <Border Style="{StaticResource SectionCard}">
                                <StackPanel>
                                    <Grid>
                                        <TextBlock Text="Cards" Style="{StaticResource SectionTitle}" />
                                        <TextBlock x:Name="CardSizeText" HorizontalAlignment="Right" FontSize="12"
                                                   Foreground="{StaticResource SecondaryBrush}" />
                                    </Grid>
                                    <Grid Margin="0,6,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="&#xE80A;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="12"
                                                   VerticalAlignment="Center" Foreground="{StaticResource MutedBrush}" />
                                        <Slider x:Name="CardSlider" Grid.Column="1" Margin="10,0" Minimum="150" Maximum="420"
                                                TickFrequency="10" IsSnapToTickEnabled="True" SmallChange="10" LargeChange="40"
                                                ValueChanged="CardSlider_ValueChanged" />
                                        <TextBlock Grid.Column="2" Text="&#xE80A;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                                   FontSize="20" VerticalAlignment="Center" Foreground="{StaticResource MutedBrush}" />
                                    </Grid>
                                    <Grid Margin="0,8,0,0">
                                        <TextBlock Style="{StaticResource Hint}" Margin="0,0,70,0"
                                                   Text="Shortcut: Ctrl + mouse wheel over the games, or Ctrl + / Ctrl − / Ctrl 0." />
                                        <Button Style="{StaticResource SmallBtn}" Content="Reset" HorizontalAlignment="Right"
                                                VerticalAlignment="Center" Click="CardReset_Click" />
                                    </Grid>
                                    <Grid Margin="0,14,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
                                            <TextBlock Text="Shape" FontSize="13" />
                                            <TextBlock Style="{StaticResource Hint}" Text="Portrait uses Steam's tall library art" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                            <RadioButton x:Name="LandscapeRadio" GroupName="CardShape" Content="Landscape" MinWidth="0"
                                                         Margin="0,0,10,0" Checked="CardShape_Click" />
                                            <RadioButton x:Name="PortraitRadio" GroupName="CardShape" Content="Portrait" MinWidth="0"
                                                         Checked="CardShape_Click" />
                                        </StackPanel>
                                    </Grid>
                                    <CheckBox x:Name="CardTextBox" Content="Show names under the cards" Margin="0,10,0,0"
                                              Checked="CardText_Click" Unchecked="CardText_Click" />
                                    <Grid Margin="0,14,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="44" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="Spacing" FontSize="13" VerticalAlignment="Center" Margin="0,0,12,0" />
                                        <Slider x:Name="SpacingSlider" Grid.Column="1" Minimum="0" Maximum="48" TickFrequency="2"
                                                IsSnapToTickEnabled="True" SmallChange="2" LargeChange="8"
                                                ValueChanged="SpacingSlider_ValueChanged" />
                                        <TextBlock x:Name="SpacingText" Grid.Column="2" HorizontalAlignment="Right" VerticalAlignment="Center"
                                                   FontSize="12" Foreground="{StaticResource SecondaryBrush}" />
                                    </Grid>
                                    <CheckBox x:Name="ScrollByRowBox" Content="Scroll one row at a time" Margin="0,10,0,0"
                                              Click="Option_Click" />
                                    <TextBlock Style="{StaticResource Hint}" Margin="30,0,0,0"
                                               Text="The mouse wheel glides to the next row of cards instead of scrolling freely." />
                                </StackPanel>
                            </Border>

                            <!-- Random game (dice in the header) -->
                            <Border Style="{StaticResource SectionCard}">
                                <StackPanel>
                                    <TextBlock Text="Random game" Style="{StaticResource SectionTitle}" />
                                    <TextBlock Style="{StaticResource Hint}" Margin="0,4,0,10"
                                               Text="The dice in the title bar picks a random game from the filter you're on." />
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="Dice colour" FontSize="13" VerticalAlignment="Center" />
                                        <!-- Swatches are built in BuildDiceSwatches() -->
                                        <StackPanel x:Name="DiceSwatches" Grid.Column="1" Orientation="Horizontal" />
                                    </Grid>
                                    <CheckBox x:Name="DiceStartsBox" Content="Start the game it lands on" Margin="0,10,0,0"
                                              Click="Option_Click" />
                                    <TextBlock Style="{StaticResource Hint}" Margin="30,0,0,0"
                                               Text="Off: the game is selected, press Enter or the play button to start it." />
                                </StackPanel>
                            </Border>

                            <!-- Wallpapers -->
                            <Border Style="{StaticResource SectionCard}">
                                <StackPanel>
                                    <TextBlock Text="Wallpapers" Style="{StaticResource SectionTitle}" />
                                    <TextBlock Style="{StaticResource Hint}" Margin="0,0,0,12"
                                               Text="Give each filter its own background. Filters without one use the default. You can also right-click a filter tab." />
                                    <ItemsControl x:Name="WallpaperRows">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Grid Margin="0,0,0,8">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="76" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <Border Width="64" Height="36" CornerRadius="4" Background="#14FFFFFF"
                                                            BorderBrush="#1FFFFFFF" BorderThickness="1" HorizontalAlignment="Left">
                                                        <Border CornerRadius="3">
                                                            <Border.Background>
                                                                <ImageBrush ImageSource="{Binding Thumb}" Stretch="UniformToFill" />
                                                            </Border.Background>
                                                        </Border>
                                                    </Border>
                                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                        <StackPanel Orientation="Horizontal">
                                                            <TextBlock Text="&#xE8EC;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="12"
                                                                       Foreground="{Binding Foreground, ElementName=L}" VerticalAlignment="Center"
                                                                       Margin="0,1,6,0" Visibility="{Binding IsTag, Converter={StaticResource BoolVis}}" />
                                                            <TextBlock Text="&#xED1A;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="12"
                                                                       Foreground="{Binding Foreground, ElementName=L}" VerticalAlignment="Center"
                                                                       Margin="0,1,6,0" Visibility="{Binding IsHidden, Converter={StaticResource BoolVis}}" />
                                                            <TextBlock x:Name="L" Text="{Binding Label}" FontSize="13" />
                                                        </StackPanel>
                                                        <TextBlock Text="{Binding Note}" FontSize="11" Foreground="{StaticResource MutedBrush}"
                                                                   TextTrimming="CharacterEllipsis" Margin="0,0,8,0" />
                                                    </StackPanel>
                                                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                                        <Button Style="{StaticResource SmallBtn}" Content="Choose…" Click="WallpaperChoose_Click" />
                                                        <Button Style="{StaticResource SmallBtn}" Margin="6,0,0,0" ToolTip="Remove"
                                                                Visibility="{Binding HasImage, Converter={StaticResource BoolVis}}"
                                                                Click="WallpaperClear_Click">
                                                            <TextBlock Text="&#xE74D;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="12" />
                                                        </Button>
                                                    </StackPanel>
                                                </Grid>
                                                <DataTemplate.Triggers>
                                                    <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                                                        <Setter TargetName="L" Property="Foreground" Value="{StaticResource AccentBrush}" />
                                                        <Setter TargetName="L" Property="FontWeight" Value="SemiBold" />
                                                    </DataTrigger>
                                                </DataTemplate.Triggers>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>

                                    <Grid Margin="0,10,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="76" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="44" />
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition />
                                            <RowDefinition />
                                        </Grid.RowDefinitions>
                                        <TextBlock Text="Dim" VerticalAlignment="Center" FontSize="13" />
                                        <Slider x:Name="DimSlider" Grid.Column="1" Minimum="0" Maximum="0.9" TickFrequency="0.05"
                                                IsSnapToTickEnabled="True" ValueChanged="WallpaperLook_Changed" />
                                        <TextBlock x:Name="DimText" Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right"
                                                   FontSize="12" Foreground="{StaticResource SecondaryBrush}" />
                                        <TextBlock Grid.Row="1" Text="Blur" VerticalAlignment="Center" FontSize="13" />
                                        <Slider x:Name="BlurSlider" Grid.Row="1" Grid.Column="1" Minimum="0" Maximum="40" TickFrequency="2"
                                                IsSnapToTickEnabled="True" ValueChanged="WallpaperLook_Changed" />
                                        <TextBlock x:Name="BlurText" Grid.Row="1" Grid.Column="2" VerticalAlignment="Center"
                                                   HorizontalAlignment="Right" FontSize="12" Foreground="{StaticResource SecondaryBrush}" />
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <!-- General -->
                            <Border Style="{StaticResource SectionCard}">
                                <StackPanel>
                                    <TextBlock Text="General" Style="{StaticResource SectionTitle}" />
                                    <StackPanel Margin="0,8,0,0">
                                        <TextBlock Text="Games folder" FontSize="13" />
                                        <TextBlock Style="{StaticResource Hint}"
                                                   Text="The folder of shortcuts to show. Its Launchers, z (trainers) and Tools subfolders work the same way." />
                                        <Grid Margin="0,8,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBox x:Name="FolderBox" FontSize="12" IsReadOnly="True" IsReadOnlyCaretVisible="False"
                                                     VerticalContentAlignment="Center" />
                                            <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="8,0,0,0" VerticalAlignment="Center">
                                                <Button Style="{StaticResource SmallBtn}" Content="Browse…" Click="FolderBrowse_Click" />
                                                <Button Style="{StaticResource SmallBtn}" Margin="6,0,0,0" ToolTip="Open in File Explorer"
                                                        Click="OpenFolder_Click">
                                                    <TextBlock Text="&#xE8A7;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="12" />
                                                </Button>
                                            </StackPanel>
                                        </Grid>
                                        <TextBlock x:Name="FolderStatus" Style="{StaticResource Hint}" Margin="0,4,0,0" />
                                    </StackPanel>
                                    <Grid Margin="0,14,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="170" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="Show / hide hotkey" FontSize="13" />
                                            <TextBlock x:Name="HotkeyStatus" Style="{StaticResource Hint}" Text="Click the box, then press a combination" />
                                        </StackPanel>
                                        <TextBox x:Name="HotkeyBox" Grid.Column="1" IsReadOnly="True" IsReadOnlyCaretVisible="False"
                                                 HorizontalContentAlignment="Center" PreviewKeyDown="HotkeyBox_PreviewKeyDown" />
                                    </Grid>
                                    <CheckBox x:Name="TrainersBox" Content="Use trainers" Margin="0,14,0,0" Click="Option_Click" />
                                    <TextBlock Style="{StaticResource Hint}" Margin="30,0,0,0"
                                               Text="Off: no trainer badges, no &quot;With trainer&quot; filter, Ctrl+Enter just plays." />
                                    <Grid Margin="0,10,0,0" Visibility="{DynamicResource TrainerVis}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="130" />
                                            <ColumnDefinition Width="40" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="Trainer delay" FontSize="13" />
                                            <TextBlock Style="{StaticResource Hint}" Text="Seconds between game and trainer" />
                                        </StackPanel>
                                        <Slider x:Name="DelaySlider" Grid.Column="1" Minimum="0" Maximum="60" TickFrequency="1"
                                                IsSnapToTickEnabled="True" VerticalAlignment="Center" ValueChanged="DelaySlider_ValueChanged" />
                                        <TextBlock x:Name="DelayText" Grid.Column="2" HorizontalAlignment="Right" VerticalAlignment="Center"
                                                   FontSize="12" Foreground="{StaticResource SecondaryBrush}" />
                                    </Grid>
                                    <CheckBox x:Name="HideOnLaunchBox" Content="Hide the launcher after starting a game" Margin="0,14,0,0" Click="Option_Click" />
                                    <CheckBox x:Name="HideOnFocusLossBox" Content="Hide when I click another window" Margin="0,6,0,0" Click="Option_Click" />
                                    <CheckBox x:Name="CloseToTrayBox" Content="Close button hides to the tray" Margin="0,6,0,0" Click="Option_Click" />
                                    <CheckBox x:Name="FetchCoversBox" Content="Download cover art automatically" Margin="0,6,0,0" Click="Option_Click" />
                                    <CheckBox x:Name="TipsBox" Content="Show tips when hovering" Margin="0,6,0,0" Click="Option_Click"
                                              ToolTip="Game names, play and trainer hints, and what each button does" />
                                    <CheckBox x:Name="StartupBox" Content="Start with Windows (in the tray)" Margin="0,6,0,0" Click="Option_Click" />
                                </StackPanel>
                            </Border>

                            <Grid Margin="2,0,2,8">
                                <TextBlock Style="{StaticResource Hint}" VerticalAlignment="Center" Text="Changes save automatically." />
                                <Button Style="{StaticResource SmallBtn}" Content="Open data folder" HorizontalAlignment="Right"
                                        Click="OpenDataFolder_Click" />
                            </Grid>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
